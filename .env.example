# =============================================================================
# micasaestuya-backend — environment variables
# Copy this file to .env for desarrollo local (sin Docker).
# Al correr con Docker Compose, estas variables son inyectadas por docker-compose.yml.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------------------
# MongoDB
# Al correr sin Docker, apunta a tu instancia local de MongoDB.
# Al correr con Docker Compose, esta variable es sobreescrita por el compose.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://root:example@localhost:27017/micasaestuya-dev?authSource=admin

# Usada por `npm test` (base separada, no toca los datos de dev).
MONGODB_TEST_URI=mongodb://root:example@localhost:27017/micasaestuya-test-dev?authSource=admin

# ---------------------------------------------------------------------------
# Redis
# Al correr sin Docker, apunta a tu instancia local de Redis.
# Al correr con Docker Compose, esta variable es sobreescrita por el compose.
# ---------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379

# Usada por `npm test` (db lógica separada, no toca los datos de `redis:seed`).
REDIS_TEST_URI=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# JWT secret
# Usado para firmar y verificar JSON Web Tokens.
# Debe ser una cadena larga y aleatoria en producción.
# ---------------------------------------------------------------------------
SECRET=change_me_to_a_strong_secret
